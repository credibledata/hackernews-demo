# Copy to .env and fill in. .env is git-ignored; this file is the committed template.

# Required by the chat UI's backend. The MCP path (/mcp) never uses it.
# Docker Compose reads this file and passes the key into the container; for a
# local (non-Docker) run, app/server loads it at startup.
OPENAI_API_KEY=sk-...

# Optional, local runs only: app/server reads these from .env too. Docker
# Compose only forwards OPENAI_API_KEY and PORT, so to change them in the
# container set them in docker-compose.yml instead.
# HN_LLM_MODEL=gpt-5.6-luna   # model the chat backend drives
# HN_MAX_INFLIGHT=8           # concurrent chat messages across all clients
# HN_METRICS_TOKEN=           # if set, /chat/metrics requires ?token=

# Not read from here: the data-window vars (HN_MONTHS / HN_END / HN_TYPES).
# prep/build-data.mjs takes them from the environment: HN_MONTHS=1 npm run prep
